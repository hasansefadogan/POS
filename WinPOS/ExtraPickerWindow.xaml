<Window x:Class="WinPOS.ExtraPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ekstralar"
        Width="520" Height="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Bg}">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- BAŞLIK -->
        <Border Background="{DynamicResource Panel}" CornerRadius="16" Padding="12" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock x:Name="TxtTitle" FontSize="20" FontWeight="Bold"/>
                <TextBlock Text="İstediğin ekstraları seçebilirsin"
                           Foreground="{DynamicResource Text2}"/>
            </StackPanel>
        </Border>

        <!-- EKSTRALAR -->
        <Border Grid.Row="1" Background="{DynamicResource Panel}" CornerRadius="16" Padding="12">
            <ScrollViewer>
                <ItemsControl x:Name="ItemsExtras">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource Panel2}"
                                    CornerRadius="12"
                                    Padding="12"
                                    Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- CHECKBOX -->
                                    <CheckBox IsChecked="{Binding IsSelected}"
                                              Width="32" Height="32"
                                              VerticalAlignment="Center"/>

                                    <!-- AD -->
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Name}"
                                               FontSize="18"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"/>

                                    <!-- FİYAT -->
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding PriceText}"
                                               FontSize="16"
                                               Foreground="{DynamicResource Text2}"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- ALT BAR -->
        <Border Grid.Row="2" Background="{DynamicResource Panel}" CornerRadius="16" Padding="12" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="TxtExtraTotal"
                           FontSize="18"
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>

                <Button Grid.Column="1"
                        Content="İptal"
                        Width="120" Height="46"
                        Margin="0,0,10,0"
                        Style="{DynamicResource ModernButton}"
                        Click="Cancel_Click"/>

                <Button Grid.Column="2"
                        Content="Ekle"
                        Width="120" Height="46"
                        Style="{DynamicResource AccentButton}"
                        Click="Ok_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>

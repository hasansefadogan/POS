<Window x:Class="WinPOS.ZReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Z Raporu" Height="680" Width="980"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Bg}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Üst başlık -->
        <Border Background="{DynamicResource Panel}" CornerRadius="16" Padding="14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="{Binding ModeTitle}" FontSize="22" FontWeight="Bold"/>
                    <TextBlock Text="{Binding LastRefreshText}"
           FontSize="12"
           Foreground="Gray"
           HorizontalAlignment="Right"/>


                    <TextBlock Text="{Binding ReportTitle}" Foreground="{DynamicResource Text2}" Margin="0,4,0,0"/>
                </StackPanel>

                <Button Grid.Column="1"
        Content="Yenile"
        Height="42" MinWidth="120" Margin="0,0,10,0"
        Style="{DynamicResource ModernButton}"
        Command="{Binding RefreshCommand}" Click="Button_Click"/>

                <Button Grid.Column="3"
        Content="Yazdır"
        Height="42" MinWidth="120" Margin="0,0,10,0"
        Style="{DynamicResource AccentButton}"
        Command="{Binding PrintCommand}"/>

                <Button Grid.Column="4"
        Content="Kapat"
        Height="42" MinWidth="120"
        Style="{DynamicResource DangerButton}"
        Command="{Binding CloseCommand}"/>
                <Button Grid.Column="5"
        Content="Fiş (80mm)"
        Height="42" MinWidth="120" Margin="0,0,10,0"
        Style="{DynamicResource AccentButton}"
        Command="{Binding ReceiptPrintCommand}"/>
                <Button Grid.Column="2"
        Content="X Raporu"
        Height="42" MinWidth="120" Margin="0,0,10,0"
        Style="{DynamicResource ModernButton}"
        Command="{Binding XReportCommand}"/>



            </Grid>
        </Border>

        <!-- Özet kartlar -->
        <Grid Grid.Row="1" Margin="0,14,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Background="{DynamicResource Panel}" CornerRadius="16" Padding="12" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="NAKİT" Foreground="{DynamicResource Text2}"/>
                    <TextBlock Text="{Binding CashText}" FontSize="22" FontWeight="Bold"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Background="{DynamicResource Panel}" CornerRadius="16" Padding="12" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="KART" Foreground="{DynamicResource Text2}"/>
                    <TextBlock Text="{Binding CardText}" FontSize="22" FontWeight="Bold"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Background="{DynamicResource Panel}" CornerRadius="16" Padding="12" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="TOPLAM" Foreground="{DynamicResource Text2}"/>
                    <TextBlock Text="{Binding GrandText}" FontSize="22" FontWeight="Bold"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="3" Background="{DynamicResource Panel}" CornerRadius="16" Padding="12">
                <StackPanel>
                    <TextBlock Text="KDV" Foreground="{DynamicResource Text2}"/>
                    <TextBlock Text="{Binding VatText}" FontSize="16" FontWeight="SemiBold"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Satış listesi -->
        <Border Grid.Row="2" Background="{DynamicResource Panel}" CornerRadius="16" Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Bugünkü Satışlar" FontWeight="Bold" Margin="4,0,0,10"/>

                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding Sales}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          RowHeight="34">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Saat" Binding="{Binding Time}" Width="90"/>
                        <DataGridTextColumn Header="Ödeme" Binding="{Binding PaymentMethod}" Width="100"/>
                        <DataGridTextColumn Header="Toplam (CHF)" Binding="{Binding GrandTotalText}" Width="130"/>
                        <DataGridTextColumn Header="KDV %2.6" Binding="{Binding Vat26Text}" Width="120"/>
                        <DataGridTextColumn Header="KDV %7.7" Binding="{Binding Vat77Text}" Width="120"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</Window>

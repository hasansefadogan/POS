<Window x:Class="WinPOS.ZReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource ZReportTitle}" Height="680" Width="980"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Bg}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Üst başlık -->
        <Border Background="{DynamicResource Panel}" CornerRadius="16" Padding="14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="{Binding ModeTitle}" FontSize="22" FontWeight="Bold"/>
                    <TextBlock Text="{Binding LastRefreshText}"
           FontSize="12"
           Foreground="Gray"
           HorizontalAlignment="Right"/>


                    <TextBlock Text="{Binding ReportTitle}" Foreground="{DynamicResource Text2}" Margin="0,4,0,0"/>
                </StackPanel>

                <Button Grid.Column="1"
        Content="{DynamicResource Refresh}"
        Height="42" MinWidth="120" Margin="0,0,10,0"
        Style="{DynamicResource ModernButton}"
        Command="{Binding RefreshCommand}" Click="Button_Click"/>

                <Button Grid.Column="3"
        Content="{DynamicResource Print}"
        Height="42" MinWidth="120" Margin="0,0,10,0"
        Style="{DynamicResource AccentButton}"
        Command="{Binding PrintCommand}"/>

                <Button Grid.Column="4"
        Content="{DynamicResource Close}"
        Height="42" MinWidth="120"
        Style="{DynamicResource DangerButton}"
        Command="{Binding CloseCommand}"/>
                <Button Grid.Column="5"
        Content="{DynamicResource Receipt80mm}"
        Height="42" MinWidth="120" Margin="0,0,10,0"
        Style="{DynamicResource AccentButton}"
        Command="{Binding ReceiptPrintCommand}"/>
                <Button Grid.Column="2"
        Content="{DynamicResource XReport}"
        Height="42" MinWidth="120" Margin="0,0,10,0"
        Style="{DynamicResource ModernButton}"
        Command="{Binding XReportCommand}"/>



            </Grid>
        </Border>

        <!-- Özet kartlar -->
        <Grid Grid.Row="1" Margin="0,14,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Background="{DynamicResource Panel}" CornerRadius="16" Padding="12" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Cash}" Foreground="{DynamicResource Text2}"/>
                    <TextBlock Text="{Binding CashText}" FontSize="22" FontWeight="Bold"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Background="{DynamicResource Panel}" CornerRadius="16" Padding="12" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Card}" Foreground="{DynamicResource Text2}"/>
                    <TextBlock Text="{Binding CardText}" FontSize="22" FontWeight="Bold"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Background="{DynamicResource Panel}" CornerRadius="16" Padding="12" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Total}" Foreground="{DynamicResource Text2}"/>
                    <TextBlock Text="{Binding GrandText}" FontSize="22" FontWeight="Bold"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="3" Background="{DynamicResource Panel}" CornerRadius="16" Padding="12">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Vat}" Foreground="{DynamicResource Text2}"/>
                    <TextBlock Text="{Binding VatText}" FontSize="16" FontWeight="SemiBold"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Satış listesi -->
        <Border Grid.Row="2" Background="{DynamicResource Panel}" CornerRadius="16" Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="{DynamicResource TodaysSales}" FontWeight="Bold" Margin="4,0,0,10"/>

                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding Sales}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          RowHeight="34">
                    <DataGrid.Columns>
                        <DataGridTextColumn Binding="{Binding Time}" Width="90">
                            <DataGridTextColumn.Header>
                                <TextBlock Text="{DynamicResource Time}"/>
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <DataGridTextColumn Binding="{Binding PaymentMethod}" Width="100">
                            <DataGridTextColumn.Header>
                                <TextBlock Text="{DynamicResource Payment}"/>
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <DataGridTextColumn Binding="{Binding GrandTotalText}" Width="130">
                            <DataGridTextColumn.Header>
                                <TextBlock Text="{DynamicResource TotalCHF}"/>
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <DataGridTextColumn Binding="{Binding Vat26Text}" Width="120">
                            <DataGridTextColumn.Header>
                                <TextBlock Text="{DynamicResource Vat26}"/>
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <DataGridTextColumn Binding="{Binding Vat77Text}" Width="120">
                            <DataGridTextColumn.Header>
                                <TextBlock Text="{DynamicResource Vat77}"/>
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</Window>

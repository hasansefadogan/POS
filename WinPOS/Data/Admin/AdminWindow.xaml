<Window x:Class="WinPOS.Admin.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource AdminTitle}" Width="1040" Height="720"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Bg}">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 1) ÜRÜN EKLE -->
        <Border Grid.Row="0" Background="{DynamicResource Panel}" CornerRadius="16" Padding="12" Margin="0,0,0,10">
            <WrapPanel>
                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="{DynamicResource ProductName}"/>
                    <TextBox x:Name="TxtName" Width="210"/>
                </StackPanel>

                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="{DynamicResource PriceCHF}"/>
                    <TextBox x:Name="TxtPrice" Width="100"/>
                </StackPanel>

                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="{DynamicResource VatPercent}"/>
                    <ComboBox x:Name="CmbVat" Width="90" SelectedIndex="1">
                        <ComboBoxItem Content="2.6"/>
                        <ComboBoxItem Content="7.7"/>
                    </ComboBox>
                </StackPanel>

                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="{DynamicResource Category}"/>
                    <ComboBox x:Name="CmbCategory" Width="180"/>
                </StackPanel>

                <Button Content="{DynamicResource AddProduct}" Height="52" Width="150"
                        Style="{DynamicResource AccentButton}" Click="AddProduct_Click" Margin="0,18,0,0"/>
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="3*"/>
                    </Grid.ColumnDefinitions>

                    <!-- SOL: Ürün listesi -->
                    <DataGrid Grid.Column="0"
          ItemsSource="{Binding AdminProducts}"
          SelectedItem="{Binding SelectedAdminProduct}"
          AutoGenerateColumns="False"
          IsReadOnly="True"
          SelectionMode="Single"
          CanUserResizeColumns="True"
          ColumnWidth="*"
          HeadersVisibility="Column"
          RowHeight="28"
          FontSize="14"
          Margin="0"
          Height="420">
                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="Padding" Value="6,2"/>
                            </Style>
                        </DataGrid.CellStyle>


                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="55" />
                            <DataGridTextColumn Header="Ürün" Binding="{Binding Name}" Width="2*" />
                            <DataGridTextColumn Header="Fiyat" Binding="{Binding Price, StringFormat={}{0:0.00}}" Width="90" />
                            <DataGridTextColumn Header="KDV" Binding="{Binding Vat, StringFormat={}{0:0.0}}" Width="70" />
                            <DataGridTextColumn Header="Kat." Binding="{Binding CategoryId}" Width="65" />
                        </DataGrid.Columns>
                    </DataGrid>


                    <!-- SAĞ: Form + Butonlar -->
                    <StackPanel Grid.Column="2" VerticalAlignment="Top">
                        <TextBlock Text="Ürün Adı" />
                        <TextBox Text="{Binding EditProductName, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,10"/>

                        <TextBlock Text="Fiyat (CHF)" />
                        <TextBox Text="{Binding EditProductPrice, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,10"/>

                        <TextBlock Text="KDV (2.6 / 7.7)" />
                        <TextBox Text="{Binding EditProductVat, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,10"/>

                        <TextBlock Text="Kategori" />
                        <ComboBox ItemsSource="{Binding AdminCategories}"
                  SelectedItem="{Binding SelectedAdminCategory}"
                  DisplayMemberPath="Name"
                  Margin="0,4,0,14"/>

                        <StackPanel Orientation="Horizontal">
                            <Button Content="Yeni (Temizle)" Width="120" Margin="0,0,10,0" Click="BtnProductNew_Click"/>
                            <Button Content="Ekle" Width="90" Margin="0,0,10,0" Click="BtnProductAdd_Click"/>
                            <Button Content="Güncelle" Width="110" Margin="0,0,10,0" Click="BtnProductUpdate_Click"/>
                            <Button Content="Sil" Width="80" Click="BtnProductDelete_Click"/>
                        </StackPanel>

                        <TextBlock Text="{Binding AdminStatusText}" Margin="0,12,0,0" Opacity="0.8"/>
                    </StackPanel>
                </Grid>

            </WrapPanel>
        </Border>

        <!-- 2) KATEGORİ EKLE -->
        <Border Grid.Row="1" Background="{DynamicResource Panel}" CornerRadius="16" Padding="12" Margin="0,0,0,10">
            <WrapPanel>
                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="{DynamicResource NewCategory}"/>
                    <TextBox x:Name="TxtCategory" Width="220"/>
                </StackPanel>

                <Button Content="{DynamicResource AddCategory}" Height="52" Width="180"
                        Style="{DynamicResource ModernButton}" Click="AddCategory_Click" Margin="0,18,0,0"/>
            </WrapPanel>
        </Border>

        <!-- 3) EKSTRA EKLE + ÇOKLU KATEGORİ BAĞLA -->
        <Border Grid.Row="2" Background="{DynamicResource Panel}" CornerRadius="16" Padding="12" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="320"/>
                </Grid.ColumnDefinitions>

                <WrapPanel>
                    <StackPanel Margin="0,0,10,0">
                        <TextBlock Text="Ekstra Adı"/>
                        <TextBox x:Name="TxtExtraName" Width="220"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,10,0">
                        <TextBlock Text="Ekstra Fiyat (CHF) (0=Ücretsiz)"/>
                        <TextBox x:Name="TxtExtraPrice" Width="180"/>
                    </StackPanel>

                    <Button Content="Ekstra Ekle" Height="52" Width="150"
                            Style="{DynamicResource AccentButton}" Click="AddExtra_Click" Margin="0,18,0,0"/>
                </WrapPanel>

                <Border Grid.Column="1" Background="{DynamicResource Panel2}" CornerRadius="12" Padding="10" Margin="10,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Bu ekstra hangi kategorilerde görünsün?" FontWeight="Bold" Margin="0,0,0,6"/>
                        <ListBox x:Name="ListExtraCategories" SelectionMode="Multiple" Height="120"/>
                        <TextBlock Text="(Ctrl ile çoklu seçebilirsin)" Foreground="{DynamicResource Text2}" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- 4) LİSTELER -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{DynamicResource Panel}" CornerRadius="16" Padding="12" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Categories}" FontWeight="Bold" Margin="0,0,0,6"/>
                    <ListBox x:Name="ListCategories"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Background="{DynamicResource Panel}" CornerRadius="16" Padding="12" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Products}" FontWeight="Bold" Margin="0,0,0,6"/>
                    <ListBox x:Name="ListProducts"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Background="{DynamicResource Panel}" CornerRadius="16" Padding="12">
                <StackPanel>
                    <TextBlock Text="Ekstralar" FontWeight="Bold" Margin="0,0,0,6"/>
                    <ListBox x:Name="ListExtras"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>

<Window x:Class="WinPOS.SaleTypePickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Satış Türü"
        WindowStartupLocation="CenterOwner"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        Background="{DynamicResource Bg}"
        Padding="18">

    <Border Background="{DynamicResource Panel}" CornerRadius="16" Padding="16">
        <StackPanel Width="420">
            <TextBlock Text="Satış türünü seçin"
                       FontSize="20"
                       FontWeight="Bold"
                       Margin="0,0,0,10"/>

            <TextBlock Text="Bu sipariş Restaurant mı Takeaway mi?"
                       Foreground="{DynamicResource Text2}"
                       Margin="0,0,0,16"/>

            <Button Content="🪑 RESTAURANT  (%7.7)"
                    Height="64"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Margin="0,0,0,12"
                    Style="{DynamicResource ModernButton}"
                    Click="Restaurant_Click"/>

            <Button Content="🥡 TAKEAWAY  (%2.6)"
                    Height="64"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Margin="0,0,0,12"
                    Style="{DynamicResource AccentButton}"
                    Click="Takeaway_Click"/>

            <Button Content="İptal"
                    Height="44"
                    Style="{DynamicResource DangerButton}"
                    Click="Cancel_Click"/>
        </StackPanel>
    </Border>
</Window>

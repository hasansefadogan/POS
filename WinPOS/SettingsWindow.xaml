<Window x:Class="WinPOS.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Settings}"
        Height="520"
        Width="780"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Başlık -->
        <TextBlock Text="{DynamicResource Settings}" FontSize="22" FontWeight="Bold"/>

        <!-- Sekmeler -->
        <TabControl Grid.Row="1" Margin="0,12,0,12">
            <!-- TabItem görünümü büyüt -->
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="FontSize" Value="16"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Padding" Value="16,8"/>
                    <Setter Property="MinWidth" Value="120"/>
                    <Setter Property="MinHeight" Value="38"/>
                    <Setter Property="Margin" Value="0,0,6,0"/>
                </Style>
            </TabControl.Resources>

            <!-- GENEL -->
            <TabItem Header="{DynamicResource General}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12">

                        <TextBlock Text="{DynamicResource Lang}" FontWeight="SemiBold"/>
                        <ComboBox Width="260"
                                  ItemsSource="{Binding Languages}"
                                  SelectedItem="{Binding SelectedLanguage}"
                                  DisplayMemberPath="Display"
                                  Margin="0,6,0,18" />

                        <TextBlock Text="{DynamicResource ThemeLabel}" FontWeight="SemiBold"/>
                        <WrapPanel Margin="0,6,0,0">
                            <Button Content="{DynamicResource LightTheme}"
                                    Width="140" Height="40" Margin="0,0,10,10"
                                    Style="{DynamicResource ModernButton}"
                                    Command="{Binding SetLightThemeCommand}"/>

                            <Button Content="{DynamicResource DarkTheme}"
                                    Width="140" Height="40" Margin="0,0,10,10"
                                    Style="{DynamicResource ModernButton}"
                                    Command="{Binding SetDarkThemeCommand}"/>
                        </WrapPanel>

                        <Separator Margin="0,16,0,12"/>

                        <TextBlock Text="{DynamicResource QuickActions}" FontWeight="SemiBold" Margin="0,0,0,10"/>

                        <WrapPanel>
                            <Button Content="{DynamicResource Admin}"
                                    Width="140" Height="40" Margin="0,0,10,10"
                                    Style="{DynamicResource AccentButton}"
                                    Command="{Binding OpenAdminCommand}"/>

                            <Button Content="{DynamicResource ZReport}"
                                    Width="140" Height="40" Margin="0,0,10,10"
                                    Style="{DynamicResource ModernButton}"
                                    Command="{Binding ZReportCommand}"/>
                        </WrapPanel>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- POS -->
            <TabItem Header="POS">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12">

                        <TextBlock Text="{DynamicResource DefaultSaleType}" FontWeight="SemiBold"/>
                        <ComboBox Width="220"
                      ItemsSource="{Binding DefaultSaleTypes}"
                      SelectedItem="{Binding DefaultSaleType}"
                      Margin="0,6,0,18"/>

                        <TextBlock Text="{DynamicResource ReceiptHeader}" FontWeight="SemiBold"/>
                        <TextBox Width="360"
                     Text="{Binding ReceiptHeader, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,6,0,18"/>

                        <TextBlock Text="{DynamicResource ReceiptPrinter}" FontWeight="SemiBold"/>
                        <ComboBox Width="360"
                      ItemsSource="{Binding Printers}"
                      SelectedItem="{Binding SelectedReceiptPrinter}"
                      Margin="0,6,0,6"/>

                        <TextBlock Text="{DynamicResource PrinterNote}"
                       Opacity="0.7" />

                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Kapat -->
        <Button Grid.Row="2"
                Content="{DynamicResource Close}"
                Width="120"
                HorizontalAlignment="Right"
                IsCancel="True"/>
    </Grid>
</Window>
